# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Groq (OpenAI-compatible endpoint) — SERVER-SIDE ONLY.
# Deliberately NOT prefixed EXPO_PUBLIC_: Expo inlines EXPO_PUBLIC_*
# vars into the client bundle at build time, which would leak this key
# to anyone who opens devtools or decompiles the app. It's read only by
# the Vercel serverless function at /api/groq.js, set as a regular
# (server) environment variable in the Vercel project settings — never
# put it in a client .env file that ships with the app.
GROQ_API_KEY=your-groq-api-key-here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Native (iOS/Android) builds only — point this at your deployed web
# origin so the app can reach /api/groq without a same-origin server to
# fall back to. Leave unset for local web dev and for Vercel itself
# (relative /api path resolves against the app's own origin there).
# EXPO_PUBLIC_API_BASE_URL=https://your-app.vercel.app

# ---- Aviva Pro (App Store in-app purchases) ----
# SERVER-SIDE (Vercel > Project Settings > Environment Variables). Secrets live ONLY here.
# Which service confirms purchases: "revenuecat" (default) or "apple".
# Must match EXPO_PUBLIC_PURCHASE_PROVIDER in the app build.
PURCHASE_PROVIDER=revenuecat

# If PURCHASE_PROVIDER=revenuecat:
REVENUECAT_SECRET_KEY=sk_your_revenuecat_secret_key
REVENUECAT_ENTITLEMENT_ID=pro

# If PURCHASE_PROVIDER=apple (App Store Connect > Users and Access > Integrations > In-App Purchase):
APPLE_BUNDLE_ID=com.yourname.adhdlifecoach
APPLE_APP_ID=1234567890
APPLE_IAP_KEY_ID=ABC123DEFG
APPLE_IAP_ISSUER_ID=your-issuer-id
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_LIFETIME_PRODUCT_ID=aviva_pro_lifetime

# Optional backstop: free AI requests per IP address per day, enforced on
# the server. Leave unset (off) unless you see abuse; students on shared
# campus wifi share one IP.
# FREE_AI_PER_IP_PER_DAY=40

# CLIENT-SIDE (public, baked into the app at build time; no secrets here).
# For the iPhone app these go in eas.json (build > production > env).
EXPO_PUBLIC_PURCHASE_PROVIDER=revenuecat
# RevenueCat PUBLIC Apple key (starts with appl_). Safe to ship in the app.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_public_key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
# Product IDs (must match App Store Connect exactly):
EXPO_PUBLIC_IAP_MONTHLY_ID=aviva_pro_monthly
EXPO_PUBLIC_IAP_YEARLY_ID=aviva_pro_yearly
EXPO_PUBLIC_IAP_LIFETIME_ID=aviva_pro_lifetime
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-app.vercel.app/privacy
# Optional: shown to web users so they can find the iPhone app.
# EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id1234567890
# Free AI requests per day before the upgrade popup shows.
EXPO_PUBLIC_FREE_AI_PER_DAY=5

# Never commit the real .env file. See .gitignore.
